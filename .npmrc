# Supply-chain hardening (see CLAUDE.md conventions):
# - Takumi Guard registry proxy (anonymous mode): blocks known-malicious
#   packages at install time. Write ops would need --registry=https://registry.npmjs.org/
#   but this package is never published to npm.
registry=https://npm.flatt.tech/
# - Refuse package versions published less than 7 days ago (npm >= 11.10).
#   Most malicious releases are yanked within hours; the cooldown skips them.
min-release-age=7
